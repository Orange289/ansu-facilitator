# Contact form SMTP settings
# For Gmail use an app password, not your regular Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-app-password
CONTACT_FROM=your-sending-account@gmail.com
CONTACT_TO=ansu.facilitator@gmail.com
